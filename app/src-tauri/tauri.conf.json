{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Mountlet",
  "version": "0.7.0",
  "identifier": "com.ericholt.mountlet",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Mountlet",
        "width": 1180,
        "height": 760,
        "minWidth": 360,
        "minHeight": 120,
        "resizable": true,
        "visible": false,
        "skipTaskbar": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "nsis", "dmg"],
    "publisher": "Eric Holt",
    "category": "Utility",
    "shortDescription": "Manage cloud storage accounts from one desktop app.",
    "longDescription": "Mountlet manages, browses, mounts, and synchronizes files across cloud storage providers through rclone.",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "resources": ["vendor/rclone/**/*"],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "macOS": {
      "minimumSystemVersion": "11.0"
    }
  }
}
